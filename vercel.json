{
  "framework": "nextjs",
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "paodequeijodaira.vercel.app"
        }
      ],
      "destination": "https://paodequeijodaira.com.br/$1",
      "permanent": true
    }
  ]
}